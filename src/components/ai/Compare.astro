---
import { useAITranslations } from '../../i18n/utils';
export interface Props { lang: 'en' | 'fr' | 'ko'; }
const { lang } = Astro.props;
const t = useAITranslations(lang);

const rows = [
  { key: 'bestfor',    icon: '🎯' },
  { key: 'stage',      icon: '📍' },
  { key: 'engagement', icon: '⏱' },
  { key: 'audience',   icon: '👥' },
];
---
<section id="compare">
  <span class="section-label reveal">{t('cmp.label')}</span>
  <h2 class="section-title reveal">{t('cmp.title')}</h2>
  <p class="section-desc reveal">{t('cmp.desc')}</p>

  <div class="cmp-cards reveal">
    {[1, 2, 3, 4].map(n => (
      <div class="cmp-card">
        <div class="cmp-card-head">
          <span class="cmp-num">{n}</span>
          <span class="cmp-svc-name">{t(`svc${n}.title`)}</span>
        </div>
        <div class="cmp-card-body">
          {rows.map(({ key, icon }) => (
            <div class="cmp-row">
              <span class="cmp-row-key"><span>{icon}</span>{t(`cmp.${key}`)}</span>
              <span class="cmp-row-val">{t(`cmp.svc${n}.${key}`)}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.cmp-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 48px;
}

.cmp-card {
  background: #161B22;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.09);
  overflow: hidden;
  transition: border-color 0.25s, transform 0.25s;
}
.cmp-card:hover {
  border-color: rgba(229,57,53,0.4);
  transform: translateY(-3px);
}

.cmp-card-head {
  background: #21262D;
  border-top: 3px solid #E53935;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.cmp-num {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #E53935;
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 3px 10px rgba(229,57,53,0.4);
}

.cmp-svc-name {
  color: #fff;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1.3;
}

.cmp-card-body { }

.cmp-row {
  padding: 14px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.cmp-row:last-child { border-bottom: none; }

.cmp-row-key {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.4);
}

.cmp-row-val {
  font-size: 0.83rem;
  font-weight: 500;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

@media (max-width: 900px) {
  .cmp-cards { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 500px) {
  .cmp-cards { grid-template-columns: 1fr; }
}
</style>
