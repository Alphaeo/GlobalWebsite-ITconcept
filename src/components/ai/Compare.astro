---
import { useAITranslations } from '../../i18n/utils';
export interface Props { lang: 'en' | 'fr' | 'ko'; }
const { lang } = Astro.props;
const t = useAITranslations(lang);

const rows = [
  { key: 'bestfor',    icon: '🎯', label: t('cmp.bestfor') },
  { key: 'stage',      icon: '📍', label: t('cmp.stage') },
  { key: 'engagement', icon: '⏱',  label: t('cmp.engagement') },
  { key: 'audience',   icon: '👥', label: t('cmp.audience') },
];
---
<section id="compare">
  <span class="section-label reveal">{t('cmp.label')}</span>
  <h2 class="section-title reveal">{t('cmp.title')}</h2>
  <p class="section-desc reveal">{t('cmp.desc')}</p>

  <div class="cmp-wrap reveal">
    <table class="cmp-table">
      <thead>
        <tr>
          <th class="cmp-th-empty"></th>
          {[1,2,3,4].map(n => (
            <th>
              <span class="cmp-badge">{n}</span>
              {t(`svc${n}.title`)}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map(({ key, icon, label }) => (
          <tr>
            <td class="cmp-row-label">{icon} {label}</td>
            {[1,2,3,4].map(n => (
              <td>{t(`cmp.svc${n}.${key}`)}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
.cmp-wrap {
  margin-top: 44px;
  overflow-x: auto;
}

.cmp-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 640px;
}

/* ── Headers ── */
.cmp-th-empty {
  width: 150px;
}

.cmp-table thead th {
  padding: 8px 20px 20px;
  text-align: left;
  border-bottom: 2px solid #2e2e2e;
  color: #ffffff;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  vertical-align: bottom;
  line-height: 1.35;
}

.cmp-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #E53935;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  margin-right: 8px;
  margin-bottom: 2px;
  vertical-align: middle;
}

/* ── Body rows ── */
.cmp-table tbody tr {
  border-bottom: 1px solid #272727;
}
.cmp-table tbody tr:last-child {
  border-bottom: none;
}
.cmp-table tbody tr:hover td {
  color: #e5e7eb;
}

.cmp-table tbody td {
  padding: 18px 20px;
  vertical-align: top;
  color: #9ca3af;
  font-size: 0.85rem;
  line-height: 1.6;
}

/* ── Row label ── */
.cmp-row-label {
  color: #6b7280 !important;
  font-size: 0.72rem !important;
  font-weight: 700 !important;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  white-space: nowrap;
  padding-top: 20px !important;
}
</style>
